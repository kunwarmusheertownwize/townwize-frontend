# Stage 1: Build React app
FROM node:22 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .

# Pass Render env vars into build
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_GOOGLE_PLACES_API_KEY
ARG VITE_GOOGLE_GEOCODE_API_KEY

ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}
ENV VITE_GOOGLE_PLACES_API_KEY=${VITE_GOOGLE_PLACES_API_KEY}
ENV VITE_GOOGLE_GEOCODE_API_KEY=${VITE_GOOGLE_GEOCODE_API_KEY}

RUN npm run build

# Stage 2: Serve with NGINX
FROM nginx:1.27

# Copy Nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy htpasswd
COPY .htpasswd /etc/nginx/.htpasswd

# Copy built frontend files from builder
COPY --from=builder /app/dist /usr/share/nginx/html/

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
    